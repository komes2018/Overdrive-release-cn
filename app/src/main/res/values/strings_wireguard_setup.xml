    <string name="wgsetup_phone_title">Open this on your phone</string>
    <string name="wgsetup_phone_steps">Scan the code, sign in, then upload or paste the config your router exported. The phone must reach the car (same Wi-Fi or hotspot, or through an active tunnel).</string>
